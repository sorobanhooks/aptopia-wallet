{
  "name": "Aptopia",
  "version": "1.0.9",
  "version_name": "1.0.9",
  "description": "Aptopia is a non-custodial wallet extension that enables you to sign Stellar transactions via your browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{3ee0dd4e-8c64-4b92-b539-25718a10f62f}"
    }
  },
  "background": {
    "service_worker": "background.min.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.min.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.xyra.desiflex.in/*",
    "https://*.stellar.org/*",
    "https://*.soroswap.finance/*",
    "https://*.stellar.expert/*"
  ],
  "manifest_version": 3
}
