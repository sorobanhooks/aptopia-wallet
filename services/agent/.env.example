PORT=3000
NETWORK=stellar:testnet
USDC_ASSET_CODE=USDC
USDC_DECIMALS=7
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_API_KEY=replace-with-openzeppelin-api-key
RECEIVER_WALLET=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOROBANHOOKS_BASE_URL=http://localhost:8080/api/v1
SOROBANHOOKS_INDEXER_API_KEY=replace-with-sorobanhooks-indexer-api-key
REQUEST_TIMEOUT_MS=10000
ALERTS_CACHE_TTL_SECONDS=30
# Alert when agent USDC is below this OR cannot cover each x402 request (see X402_PAYWALL_PRICE_USDC)
USDC_LOW_BALANCE_FLOOR=0.05
# Must match paywall price in src/index.ts (e.g. $0.01)
X402_PAYWALL_PRICE_USDC=0.01
# Min ms between repeat low-balance Telegram pings per agent (default 1 hour)
LOW_BALANCE_ALERT_COOLDOWN_MS=3600000
# Tier 1: min ms between auto-swaps while price stays in the same buy/sell band (edge from neutral always allowed)
# TIER1_SAME_ZONE_COOLDOWN_MS=30000