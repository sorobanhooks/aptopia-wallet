PORT=3000
NETWORK=stellar:testnet
USDC_ASSET_CODE=USDC
USDC_DECIMALS=7
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_API_KEY=replace-with-openzeppelin-api-key
RECEIVER_WALLET=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOROBANHOOKS_BASE_URL=http://localhost:8080/api/v1
SOROBANHOOKS_INDEXER_API_KEY=replace-with-sorobanhooks-indexer-api-key
STELLAR_MAINNET_RPC=https://mainnet.sorobanrpc.com
STELLAR_TESTNET_RPC=https://soroban-testnet.stellar.org
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
REQUEST_TIMEOUT_MS=10000
ALERTS_CACHE_TTL_SECONDS=30
# --- Wallet-facing /v1 auth (SIWE-style) ---
# HS256 secret for signing wallet-auth JWTs. REQUIRED in production.
JWT_SIGNING_SECRET=replace-with-strong-random-secret
# Domain shown in the SIWE challenge message the wallet signs.
AUTH_DOMAIN=xyra.wallet
# CORS origin for the extension. Use a specific chrome-extension://<id> in prod;
# defaults to allowing any chrome-extension origin.
WALLET_ORIGIN=chrome-extension://*
# Alert when agent USDC is below this OR cannot cover each x402 request (see X402_PAYWALL_PRICE_USDC)
USDC_LOW_BALANCE_FLOOR=0.05
# Must match paywall price in src/index.ts (e.g. $0.01)
X402_PAYWALL_PRICE_USDC=0.01
# Min ms between repeat low-balance Telegram pings per agent (default 1 hour)
LOW_BALANCE_ALERT_COOLDOWN_MS=3600000
# Tier 1: min ms between auto-swaps while price stays in the same buy/sell band (edge from neutral always allowed)
# TIER1_SAME_ZONE_COOLDOWN_MS=30000
# Master key for envelope encryption of agent secrets (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER use a placeholder value in production. The server rejects an unset,
# placeholder, or non-32-byte KEK at startup (fail-loud), so copying this file
# without generating a real key will not silently encrypt under a weak key.
AGENT_SECRET_KEK_BASE64=replace-with-32-byte-base64-kek
