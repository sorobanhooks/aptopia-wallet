{
  "name": "x402-paywall-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express paywall server for Sorobanhooks endpoints using @x402/stellar",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@x402/core": "^2.9.0",
    "@x402/express": "^2.9.0",
    "@x402/fetch": "^2.9.0",
    "@x402/stellar": "^2.9.0",
    "axios": "^1.15.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "mongoose": "^9.4.1",
    "nodemon": "^3.1.14",
    "stellar-sdk": "^13.3.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
