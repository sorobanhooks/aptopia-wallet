# Baku API — DEMO config for the multi-tx buffer-first redemption vault.
# Run:  cd api && bun --env-file=.env.demo run src/index.ts
# (Production leaves these unset and uses the canonical addresses in src/addresses.ts.)
#
# Demonstrates: single-tx deposit -> 30/40/30 (Blend + real Soroswap LP + native),
# and INSTANT redeem from the native buffer (withdraw amounts <= the 30% buffer).
# Large (> buffer) redeems use the queued request_redeem/claim_redeem flow, which
# is NOT yet exposed by the API (deposit + instant-redeem only for this demo).

NETWORK=testnet
PORT=8787

# Demo XLM vault (new allocator with native-only withdraw + multi-tx primitives).
BAKU_TESTNET_VAULT_XLM=CATSMPDW4JOQOCFPKD7G3JLOADELJMFUIY3CPTYL75LMXBFG7S6VE2AA
# The vault's active strategy = the weighted meta-allocator (enables the API's
# /state per-child 30/40/30 breakdown + "Allocator" labelling).
BAKU_TESTNET_ALLOCATOR_XLM=CABUTXJDNEUUVXHEBZIK54U7RJA77GRHWV3Z6TW3ZMZSFTDR26O4YRO5
# Its children (for the /addresses + /strategies surface; the vault also reports
# its on-chain registry directly).
BAKU_TESTNET_BLEND_STRATEGY_XLM=CBPKFT2AC5C4DWBE2DXPZI3C76UTDOMUTWDUTKCME5KW3IPZDBW3QNKH
BAKU_TESTNET_SOROSWAP_STRATEGY_XLM=CAWL7IHKEL73UYSLTFYXTMZB5FMJ3V3FWW57BDBCYPANJNUKABHYRTQW

# Read-source for view simulations (any funded testnet account).
ADMIN_ADDR=GCWHACNPCEV6FPANBP3WMHFSR3LXMZO5CNIZNEKEKV7PAM2TBJ5HEVTV
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
